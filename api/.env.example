DATABASE_URL=postgres://railway:railway@localhost:5432/railway_like
REDIS_URL=redis://localhost:6379
# Variable encryption keys. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=dev-1:REPLACE_WITH_BASE64_32_BYTES
ENCRYPTION_CURRENT_KID=dev-1
# Secret do GitHub App usado para validar X-Hub-Signature-256 nos webhooks.
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_GITHUB_APP_WEBHOOK_SECRET
