{
  "name": "@railway-like/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db": "drizzle-kit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@railway-like/db": "workspace:*",
    "@railway-like/shared": "workspace:*",
    "@stoplight/elements": "9.0.27",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.6.0",
    "ioredis": "^5.11.1",
    "js-yaml": "4.3.2",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.0",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
